# ============================================================
# 🔐 SECURITY — REQUIRED FOR ALL DEPLOYMENTS
# ============================================================
# Master Studio Passcode — used to unlock the OmniStudio UI.
# ** DO NOT USE 9228 or any trivial value. **
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
STUDIO_PASSCODE=

# Backend API Token — used by automation/scripts (optional, bypasses PIN).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_TOKEN=

# Admin API Token — REQUIRED for POST /api/settings/keys (changing AI keys).
# This is a SEPARATE token from the studio passcode; limit distribution.
ADMIN_API_TOKEN=

# JWT Signing Secret — issues 12-hour sessions after PIN verification.
# ** Must be at least 32 random characters. **
# Generate with: python -c "from jose import jwk; import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=12

# Supabase JWT Secret (from Supabase Dashboard → Settings → API → JWT Secret)
# Required if you use Supabase OAuth as an alternative to the studio PIN.
SUPABASE_JWT_SECRET=

# ============================================================
# ☁️ Cloudflare R2 Object Storage (Zero Egress Bandwidth)
# ============================================================
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=omnistudio-assets
R2_PUBLIC_DOMAIN=https://pub-your_bucket.r2.dev

# ============================================================
# 🤖 AI Model Credentials (BYOK — Bring Your Own Keys)
# ============================================================
OPENAI_API_KEY=sk-your_openai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
REPLICATE_API_TOKEN=your_replicate_api_token
GEMINI_API_KEY=your_gemini_api_key

# ============================================================
# 🗄️ Supabase Cloud Database (Omni Project)
# ============================================================
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Database (PostgreSQL direct connection string — optional fallback)
DATABASE_URL=

# ============================================================
# 🌐 Server / Networking (OPTIONAL — defaults are safe)
# ============================================================
HOST=0.0.0.0
PORT=8000
# Comma separated CORS origins. Wildcard "*" is automatically rejected by the server.
CORS_ORIGINS=http://localhost:3000,http://localhost:3050,http://127.0.0.1:3000,http://127.0.0.1:3050
