# Cloudflare R2 Object Storage (Zero Egress Bandwidth)
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=omnistudio-assets
R2_PUBLIC_DOMAIN=https://pub-your_bucket.r2.dev

# AI Model Credentials (BYOK)
OPENAI_API_KEY=sk-your_openai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
REPLICATE_API_TOKEN=your_replicate_api_token
GEMINI_API_KEY=your_gemini_api_key

# Supabase Cloud Database (Omni Project)
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Database (PostgreSQL direct connection string - optional)
DATABASE_URL=
