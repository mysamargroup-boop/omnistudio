# Supabase Cloud Authentication & Realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Leave empty to use Next.js built-in reverse proxy (/api -> backend)
NEXT_PUBLIC_API_URL=

# Studio Security Passcode / Master PIN (matches backend STUDIO_PASSCODE)
NEXT_PUBLIC_STUDIO_PIN=
