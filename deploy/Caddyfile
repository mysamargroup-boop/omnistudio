    encode gzip zstd

    # Real-Time SSE Progress HUD Streaming (Zero Buffering)
    @sse path /api/pipeline/run-stream*
    handle @sse {
        reverse_proxy localhost:8050 {
            flush_interval -1
        }
    }

    # FastAPI Backend API & Media Outputs
    @backend path /api/* /outputs/* /docs* /redoc* /openapi.json*
